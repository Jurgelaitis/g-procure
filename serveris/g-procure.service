# G-Procure DI serveris (api.g-procure.com -> 127.0.0.1:3000): DI užduotys, ESG vertinimas, rinkos rodikliai. Nuo 2026-11-23 vietoj pm2 (root)
# (saugumo auditas G-05). Kopijuojama į /etc/systemd/system/g-procure.service. Kodas - /var/www/g-procure (root, tik skaityti),
# DI užduočių šablonai - /var/www/g-procure/uzduotys (root:gp-uzduotys, 750 / 640 - šablonai privatūs, skaito tik ši paslauga ir root).
[Unit]
Description=G-Procure DI serveris
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --max-old-space-size: V8 surenka šiukšles prieš pasiekdamas systemd ribą (užklausos kūnas - iki 10 MB, vienu metu - iki 12 DI užklausų)
ExecStart=/usr/bin/node --max-old-space-size=384 /var/www/g-procure/index.js
WorkingDirectory=/var/www/g-procure
Environment=NODE_ENV=production
# Slapti nustatymai: .env (root, 600) pateikiamas kaip kredencialas $CREDENTIALS_DIRECTORY/env - procesas pats .env failo neskaito,
# reikšmės nepatenka į aplinkos kintamuosius
LoadCredential=env:/var/www/g-procure/.env
# Naudotojas be teisių, sukuriamas paleidžiant (vardas - g-procure, todėl grupė kitu vardu); grupė gp-uzduotys - tik DI užduočių
# šablonams skaityti. Į diską nerašo.
DynamicUser=yes
SupplementaryGroups=gp-uzduotys
UMask=0027
Restart=on-failure
RestartSec=5
# Izoliacija
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Ištekliai
MemoryHigh=600M
MemoryMax=720M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
