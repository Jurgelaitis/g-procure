# G-Procure viešų pirkimų sutarčių duomenys (VDA sutartys, RC finansinės ataskaitos, TED). Diegimas - serveris/README.md.
# Kopijuojama į /etc/systemd/system/g-procure-sutartys.service. Kodas - /opt/g-procure-sutartys (root, tik skaityti).
[Unit]
Description=G-Procure viesu pirkimu sutarciu duomenys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --max-old-space-size: V8 surenka šiukšles prieš pasiekdamas systemd ribą (talpykla - iki 300 rezultatų, šaltinio atsakymas -
# iki 20 MB; vienu metu - 2 darbai)
ExecStart=/usr/bin/node --max-old-space-size=256 /opt/g-procure-sutartys/viesos-sutartys-serveris.js
WorkingDirectory=/opt/g-procure-sutartys
Environment=NODE_ENV=production
Environment=PORT=3003
# Naudotojas be teisių, sukuriamas paleidžiant; į diską nerašo (talpykla - tik atmintyje). Raktų nėra.
DynamicUser=yes
UMask=0027
Restart=on-failure
RestartSec=10
# Izoliacija
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Ištekliai
MemoryHigh=400M
MemoryMax=560M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
