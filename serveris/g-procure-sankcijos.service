# G-Procure sankcijų sąrašų patikra (ES, JT, OFAC, JK). Diegimas - serveris/README.md.
# Kopijuojama į /etc/systemd/system/g-procure-sankcijos.service. Kodas - /opt/g-procure-sankcijos (root, tik skaityti).
[Unit]
Description=G-Procure sankciju sarasu patikra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --max-old-space-size: V8 surenka šiukšles prieš pasiekdamas systemd ribą (atnaujinant atmintyje - failo tekstas,
# skaitomi įrašai ir ankstesnis sąrašas; OFAC SDN failas 2026-11-08 - 29,6 MB)
ExecStart=/usr/bin/node --max-old-space-size=512 /opt/g-procure-sankcijos/sankcijos-serveris.js
WorkingDirectory=/opt/g-procure-sankcijos
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=ATNAUJINIMAS_VAL=24
# Naudotojas be teisių, sukuriamas paleidžiant; vienintelis rašomas katalogas - /var/lib/g-procure-sankcijos. Raktų nėra.
DynamicUser=yes
StateDirectory=g-procure-sankcijos
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=10
# Izoliacija
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Ištekliai
MemoryHigh=700M
MemoryMax=850M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
