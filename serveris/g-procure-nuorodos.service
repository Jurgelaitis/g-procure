# G-Procure trumpos kvietimų nuorodos (elektroninė apklausa, PP-report). Diegimas - serveris/README.md.
# Kopijuojama į /etc/systemd/system/g-procure-nuorodos.service. Kodas - /opt/g-procure-nuorodos (root, tik skaityti).
[Unit]
Description=G-Procure trumpos kvietimu nuorodos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ne daugiau 5 000 užšifruotų kodų (įprastai ~1 KB, ne daugiau 16 KB) - blogiausiu atveju ~80 MB; scrypt - 16 MB vienai užklausai
ExecStart=/usr/bin/node --max-old-space-size=192 /opt/g-procure-nuorodos/nuorodos-serveris.js
WorkingDirectory=/opt/g-procure-nuorodos
Environment=NODE_ENV=production
Environment=PORT=3004
# Naudotojas be teisių, sukuriamas paleidžiant; vienintelis rašomas katalogas - /var/lib/g-procure-nuorodos (užšifruoti kodai). Raktų nėra.
DynamicUser=yes
StateDirectory=g-procure-nuorodos
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
# Izoliacija
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Į internetą nesijungia - tik priima nginx užklausas
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Ištekliai
MemoryHigh=250M
MemoryMax=350M
TasksMax=32
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
