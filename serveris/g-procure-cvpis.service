# G-Procure CVP IS duomenų paslauga (VPT API). Diegimas - serveris/README.md.
# Kopijuojama į /etc/systemd/system/g-procure-cvpis.service. Kodas - /opt/g-procure-cvpis (root, tik skaityti).
[Unit]
Description=G-Procure CVP IS duomenu paslauga (VPT API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --max-old-space-size: V8 surenka šiukšles prieš pasiekdamas systemd ribą (atnaujinant atmintyje - senas ir naujas sąrašas;
# 2026-10-18 pirmas atnaujinimas - 538 MB piko metu).
ExecStart=/usr/bin/node --max-old-space-size=768 /opt/g-procure-cvpis/cvpis-serveris.js
WorkingDirectory=/opt/g-procure-cvpis
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=ATNAUJINIMAS_VAL=6
# VPT raktas - failas, kurį skaito tik systemd ir perduoda paslaugai jos kredencialų kataloge (ne aplinkos kintamasis).
LoadCredential=vpt_api_key:/etc/g-procure-cvpis/vpt_api_key
# Naudotojas be teisių, sukuriamas paleidžiant; vienintelis rašomas katalogas - /var/lib/g-procure-cvpis.
DynamicUser=yes
StateDirectory=g-procure-cvpis
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=10
# Izoliacija
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Ištekliai
MemoryHigh=1000M
MemoryMax=1200M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
